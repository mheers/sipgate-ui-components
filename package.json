{
  "name": "@mheers/sipgate-ui-components",
  "version": "0.1.1",
  "description": "A considered Vue 3 component library for building sipgate applications — calls, messages, contacts, devices and numbers.",
  "keywords": [
    "sipgate",
    "telephony",
    "vue",
    "vue3",
    "components",
    "ui",
    "design-system",
    "shadcn",
    "tailwindcss",
    "storybook",
    "call-center",
    "sms"
  ],
  "homepage": "https://github.com/mheers/sipgate-ui-components#readme",
  "bugs": {
    "url": "https://github.com/mheers/sipgate-ui-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mheers/sipgate-ui-components.git"
  },
  "license": "MIT",
  "author": {
    "name": "Marcel Heers",
    "email": "marcel@heers.it",
    "url": "https://github.com/mheers"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "vite build && node scripts/build-styles.mjs && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:storybook": "storybook build",
    "preview:storybook": "npx --yes http-server storybook-static -p 6007 -c-1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:dev": "vite --config examples/cockpit/vite.config.ts",
    "example:build": "vite build --config examples/cockpit/vite.config.ts",
    "example:build:dist": "SG_USE_DIST=1 vite build --config examples/cockpit/vite.config.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react",
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@10.11.0"
}
